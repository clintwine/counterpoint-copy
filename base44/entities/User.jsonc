{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "User role"
    },
    "subscription": {
      "type": "string",
      "enum": [
        "free",
        "paid"
      ],
      "default": "free",
      "description": "Whether the user has a paid or free subscription"
    }
  }
}